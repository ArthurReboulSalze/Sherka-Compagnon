{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "widget",
  "description": "Le widget peut lire son état, être déplacé et ouvrir le panneau. Aucun accès fichier ou réseau.",
  "windows": [
    "widget"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-get-snapshot",
    "allow-get-comfy-service",
    "allow-switch-companion",
    "allow-set-guest-companion",
    "allow-new-hermes-conversation",
    "allow-widget-action",
    "allow-get-conversation",
    "allow-get-voice-service",
    "allow-desktop-tool",
    "allow-get-illustration",
    "allow-widget-surface",
    "allow-send-message",
    "allow-get-attachment-support",
    "allow-refresh-illustration",
    "allow-set-illustration-prompt",
    "allow-reset-illustration-prompt",
    "allow-initiative-activity",
    "allow-save-widget-cell",
    "allow-image-fullscreen"
  ]
}

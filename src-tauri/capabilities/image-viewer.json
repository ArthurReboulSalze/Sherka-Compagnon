{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "image-viewer",
  "description": "Read generated illustrations and leave full screen. No file, network or conversation access.",
  "windows": ["image-viewer"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-image-viewer",
    "allow-get-illustration",
    "allow-image-fullscreen"
  ]
}

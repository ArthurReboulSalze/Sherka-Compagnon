{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "Le panneau gère les profils et les préférences via les commandes Rust validées.",
  "windows": [
    "panel"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-startup-issue",
    "allow-close-startup-recovery",
    "allow-get-snapshot",
    "allow-get-comfy-service",
    "allow-select-comfyui-path",
    "allow-get-widget-visibility",
    "allow-apply-mutation",
    "allow-get-history",
    "allow-clear-conversation",
    "allow-get-memories",
    "allow-optimize-memory",
    "allow-get-memory-optimization",
    "allow-finish-memory-optimization",
    "allow-edit-memory",
    "allow-search-archive",
    "allow-export-memories",
    "allow-export-profile",
    "allow-widget-action",
    "allow-discover-language-models",
    "allow-get-hermes-profiles",
    "allow-get-hermes-servers",
    "allow-new-hermes-conversation",
    "allow-test-hermes",
    "allow-answer-hermes-approval",
    "allow-get-provider-key-status",
    "allow-search-key-status",
    "allow-set-search-key",
    "allow-test-search-config",
    "allow-set-provider-key",
    "allow-discover-voices",
    "allow-get-audio-devices",
    "allow-get-conversation",
    "allow-send-message",
    "allow-open-web-source",
    "allow-get-voice-service",
    "allow-retry-voice-service",
    "allow-get-update-status",
    "allow-check-update",
    "allow-install-update",
    "allow-discover-illustration",
    "allow-get-illustration",
    "allow-refresh-illustration",
    "allow-export-illustration-workflow",
    "allow-desktop-tool"
  ]
}

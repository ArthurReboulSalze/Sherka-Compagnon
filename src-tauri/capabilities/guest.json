{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "guest",
  "description": "La fenêtre du compagnon invité peut lire son état, être déplacée, redimensionnée et retirer l'invité. Aucun accès fichier ou réseau.",
  "windows": [
    "guest"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "allow-get-snapshot",
    "allow-get-conversation",
    "allow-set-guest-companion"
  ]
}

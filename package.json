{
  "name": "sherka-compagnon",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "build:windows": "tauri build --bundles nsis",
    "build:linux": "tauri build --bundles deb",
    "test:core": "cargo test -p sherka-core",
    "test:ui": "tauri build --debug --no-bundle && playwright test",
    "check": "npm run test:i18n && npm run test:catalog && tsc --noEmit && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "test:i18n": "node scripts/i18n.mjs && node --test tests/i18n.test.mjs",
    "test:catalog": "node --test tests/illustration-catalog.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.12.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArthurReboulSalze/Sherka-Compagnon.git"
  }
}
